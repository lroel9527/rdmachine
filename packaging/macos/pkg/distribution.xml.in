<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
  <title>RDMachine @VERSION@</title>
  <welcome file="welcome.html" mime-type="text/html"/>
  <conclusion file="conclusion.html" mime-type="text/html"/>
  <options customize="always" require-scripts="false" hostArchitectures="x86_64,arm64"/>
  <domains enable_anywhere="false" enable_currentUserHome="false" enable_localSystem="true"/>
  <!-- Checked before anything else, with a message of its own: macOS 12, 13
       and 14 before 14.2 are not supported (from 4.4.0: the sound needs
       14.2). The volume check below stays as a second guard. -->
  <installation-check script="checkMacOS()"/>
  <script><![CDATA[
function checkMacOS() {
  if (system.compareVersions(system.version.ProductVersion, '@MIN_MACOS@') < 0) {
    my.result.type = 'Fatal';
    my.result.title = 'RDMachine 不支持这个 macOS 版本';
    my.result.message = 'RDMachine 需要 macOS @MIN_MACOS@ 或更新的系统，这台 Mac 是 macOS ' +
        system.version.ProductVersion + '。macOS 12、13 和 14.2 以前的 14 不再支持，请先升级系统。';
    return false;
  }
  return true;
}
  ]]></script>
  <volume-check>
    <allowed-os-versions>
      <os-version min="@MIN_MACOS@"/>
    </allowed-os-versions>
  </volume-check>
  <choices-outline>
    <line choice="server"/>
    <line choice="client"/>
  </choices-outline>
  <choice id="server" title="RDMachine Server（被控端）"
          description="让别的 Mac 连到这台 Mac：服务端应用，加上开机运行的守护进程和登录窗口、用户会话里的 agent。装完立即启动；登录窗口和锁屏时也能连。">
    <pkg-ref id="org.rdmachine.server.pkg"/>
  </choice>
  <choice id="client" title="RDMachine（客户端）"
          description="从这台 Mac 连到别的 Mac。">
    <pkg-ref id="org.rdmachine.client.pkg"/>
  </choice>
  <pkg-ref id="org.rdmachine.server.pkg" version="@VERSION@" onConclusion="none">org.rdmachine.server.pkg.pkg</pkg-ref>
  <pkg-ref id="org.rdmachine.client.pkg" version="@VERSION@" onConclusion="none">org.rdmachine.client.pkg.pkg</pkg-ref>
</installer-gui-script>
