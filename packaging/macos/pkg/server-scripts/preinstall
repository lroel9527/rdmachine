#!/bin/sh
# Installer (root), before RDMachine Server.app is replaced: stop what runs
# from the old copy, so nothing holds the port or the old binary. A
# connection open through it drops; the new server starts right after.
LOG_PREFIX="rdmachine preinstall:"
uid=$(stat -f %u /dev/console)
launchctl bootout system/org.rdmachine.daemon 2>/dev/null && echo "$LOG_PREFIX stopped the daemon"
if [ "$uid" != 0 ]; then
  launchctl bootout "gui/$uid/org.rdmachine.server" 2>/dev/null && echo "$LOG_PREFIX stopped the session agent"
fi
# The login window agent (running when the Mac is at its login window): not
# a clean stop, so that launchd starts it again; postinstall restarts it once
# more from the new app. A clean stop would leave the login window without a
# picture until the next logout or restart.
pkill -KILL -f 'rdmachine-server --login-window' 2>/dev/null && echo "$LOG_PREFIX restarted the login window agent"
# A server started by hand (standalone, 2.x).
pgrep -f 'Contents/MacOS/rdmachine-server' 2>/dev/null | while read -r pid; do
  case "$(ps -o args= -p "$pid" 2>/dev/null)" in
    *--login-window*) ;;
    *) kill -TERM "$pid" 2>/dev/null && echo "$LOG_PREFIX stopped a running server (pid $pid)" ;;
  esac
done
sleep 1
exit 0
