#!/bin/sh
# rdmachine-service: runs the rdmachine server as a service of this Mac, like
# NoMachine's nxserver --install / --status / --start / --stop / --restart /
# --startmode (docs/decisions.md, "守护进程和 agent", "服务和自动启动").
#
#   sudo rdmachine-service install [--app "/Applications/RDMachine Server.app"]
#   sudo rdmachine-service uninstall
#        rdmachine-service status
#   sudo rdmachine-service start | stop | restart
#   sudo rdmachine-service startmode automatic | manual
#
# launchd is the watchdog: it starts the pieces below and starts them again
# when they exit on an error (a deliberate stop or Quit stays stopped).
#   org.rdmachine.daemon              LaunchDaemon, root, from startup: the
#                                     control port, the server identity, the
#                                     logins; hands each session to the agent
#                                     of whoever owns the console, and moves it
#                                     when that changes (login, logout, switch)
#   org.rdmachine.server.loginwindow  LaunchAgent in the login window: shows
#                                     the login window, types the password of
#                                     a password login into it
#   org.rdmachine.server              LaunchAgent in each user's session: the
#                                     menu bar app, showing that user's desktop
#
# install copies the server identity (and settings) of the user running sudo
# to /Library/Application Support/rdmachine, so clients see the fingerprint
# they already trust; an identity that is already there stays (an update
# never changes the fingerprint). It starts the daemon at once and restarts the server in
# the current session as its agent (an open connection drops once).
#
# startmode manual keeps everything installed but starts nothing by itself;
# start / stop then work on the daemon and the current session's agent.
set -eu

APP="/Applications/RDMachine Server.app"
AGENTS=/Library/LaunchAgents
DAEMONS=/Library/LaunchDaemons
DAEMON_LABEL=org.rdmachine.daemon
SESSION_LABEL=org.rdmachine.server
LW_LABEL=org.rdmachine.server.loginwindow
DAEMON_PLIST="$DAEMONS/$DAEMON_LABEL.plist"
SESSION_PLIST="$AGENTS/$SESSION_LABEL.plist"
LW_PLIST="$AGENTS/$LW_LABEL.plist"
SYS_DIR="/Library/Application Support/rdmachine"
DAEMON_LOG=/Library/Logs/rdmachine-daemon.log
LW_LOG=/Library/Logs/rdmachine-loginwindow.log

usage() {
  sed -n '2,34p' "$0" | sed 's/^# \{0,1\}//'
  exit "${1:-0}"
}

need_root() {
  if [ "$(id -u)" -ne 0 ]; then
    echo "rdmachine-service $1: run with sudo" >&2
    exit 1
  fi
}

console_user() { stat -f %Su /dev/console; }
console_uid() { stat -f %u /dev/console; }

startmode() {
  if [ ! -f "$DAEMON_PLIST" ]; then
    echo "not installed"
  elif [ "$(/usr/libexec/PlistBuddy -c 'Print :RunAtLoad' "$DAEMON_PLIST" 2>/dev/null)" = "true" ]; then
    echo automatic
  else
    echo manual
  fi
}

write_plist() {  # path label session-type(or "") run-at-load log program-args...
  path="$1"; label="$2"; session="$3"; at_load="$4"; log="$5"; shift 5
  {
    cat <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>AssociatedBundleIdentifiers</key><array><string>org.rdmachine.server</string></array>
EOF
    if [ -n "$session" ]; then
      printf '  <key>LimitLoadToSessionType</key><array><string>%s</string></array>\n' "$session"
      printf '  <key>ProcessType</key><string>Interactive</string>\n'
    fi
    printf '  <key>ProgramArguments</key><array>\n'
    for a in "$@"; do
      printf '    <string>%s</string>\n' "$a"
    done
    cat <<EOF
  </array>
  <key>RunAtLoad</key><$at_load/>
  <key>KeepAlive</key><dict><key>SuccessfulExit</key><false/></dict>
  <key>ThrottleInterval</key><integer>5</integer>
EOF
    if [ -n "$log" ]; then
      printf '  <key>StandardOutPath</key><string>%s</string>\n' "$log"
      printf '  <key>StandardErrorPath</key><string>%s</string>\n' "$log"
    fi
    cat <<EOF
</dict>
</plist>
EOF
  } > "$path"
  chown root:wheel "$path"
  chmod 644 "$path"
  plutil -lint "$path" >/dev/null
}

write_plists() {  # true|false (RunAtLoad)
  server="$APP/Contents/MacOS/rdmachine-server"
  write_plist "$DAEMON_PLIST" "$DAEMON_LABEL" "" "$1" "$DAEMON_LOG" "$server" --daemon
  write_plist "$SESSION_PLIST" "$SESSION_LABEL" Aqua "$1" "" "$server"
  write_plist "$LW_PLIST" "$LW_LABEL" LoginWindow "$1" "$LW_LOG" "$server" --login-window
  for f in "$DAEMON_LOG" "$LW_LOG"; do
    touch "$f"
    chown root:wheel "$f"
    chmod 600 "$f"
  done
}

installed_app() {
  s=$(/usr/libexec/PlistBuddy -c 'Print :ProgramArguments:0' "$DAEMON_PLIST" 2>/dev/null || true)
  [ -n "$s" ] && APP="${s%/Contents/MacOS/rdmachine-server}"
  return 0
}

daemon_loaded() { launchctl print "system/$DAEMON_LABEL" >/dev/null 2>&1; }
session_loaded() {
  uid=$(console_uid)
  [ "$uid" != 0 ] && launchctl print "gui/$uid/$SESSION_LABEL" >/dev/null 2>&1
}

start_daemon() {
  if daemon_loaded; then
    launchctl kickstart "system/$DAEMON_LABEL" 2>/dev/null || true
  else
    launchctl bootstrap system "$DAEMON_PLIST"
  fi
}

# The current session's server becomes the daemon's agent: a copy started by
# hand (standalone, holding the port) gives way to the LaunchAgent.
start_session_agent() {
  uid=$(console_uid)
  [ "$uid" = 0 ] && return 0
  if session_loaded; then
    launchctl kickstart -k "gui/$uid/$SESSION_LABEL" 2>/dev/null || true
  else
    pkill -TERM -u "$uid" -f "$APP/Contents/MacOS/rdmachine-server" 2>/dev/null || true
    sleep 1
    launchctl bootstrap "gui/$uid" "$SESSION_PLIST" 2>/dev/null || launchctl kickstart "gui/$uid/$SESSION_LABEL" 2>/dev/null || true
  fi
}

# A login window agent that is running (the Mac is at its login window, or
# a second user's) starts again from the app as it is now. It is ended with
# SIGKILL on purpose: launchd starts an agent again only after an exit that
# was not clean, and this script cannot reach the login window's own launchd
# domain to start it there.
restart_login_window_agent() {
  pkill -KILL -f 'rdmachine-server --login-window' 2>/dev/null || true
}

do_install() {
  need_root install
  server="$APP/Contents/MacOS/rdmachine-server"
  if [ ! -x "$server" ]; then
    echo "not found: $server (install RDMachine Server.app first, or pass --app)" >&2
    exit 1
  fi
  # What 2.3.0 and the experiment before it installed.
  rm -f "$AGENTS/org.rdmachine.loginwindow-experiment.plist"

  user="${SUDO_USER:-}"
  if [ -z "$user" ] || [ "$user" = root ]; then user=$(console_user); fi
  home=$(dscl . -read "/Users/$user" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
  user_dir="$home/Library/Application Support/rdmachine"
  mkdir -p "$SYS_DIR"
  chown root:wheel "$SYS_DIR"
  chmod 700 "$SYS_DIR"
  if [ -f "$SYS_DIR/server-cert.pem" ] && [ -f "$SYS_DIR/server-key.pem" ]; then
    # An update, or installed before: the daemon's identity is the one
    # clients trust by now, whatever the user's folder holds.
    echo "keeping the server identity that is installed; clients see the same fingerprint:"
  elif [ -f "$user_dir/server-cert.pem" ] && [ -f "$user_dir/server-key.pem" ]; then
    for f in server-cert.pem server-key.pem server-settings.json; do
      [ -f "$user_dir/$f" ] && install -o root -g wheel -m 600 "$user_dir/$f" "$SYS_DIR/$f"
    done
    echo "copied the server identity of $user; clients see the same fingerprint:"
  else
    echo "note: $user has no server identity yet: the daemon makes a new one, and clients are asked to trust it:" >&2
  fi
  "$server" --daemon --fingerprint --config-dir="$SYS_DIR" || true

  mode=$(startmode)
  [ "$mode" = "not installed" ] && mode=automatic
  if [ "$mode" = automatic ]; then write_plists true; else write_plists false; fi

  if [ "$mode" = automatic ]; then
    # The standalone server lets go of the port first, then the daemon takes it.
    uid=$(console_uid)
    if [ "$uid" != 0 ] && ! session_loaded; then
      pkill -TERM -u "$uid" -f "$server" 2>/dev/null || true
      sleep 1
    fi
    if daemon_loaded; then launchctl bootout "system/$DAEMON_LABEL" 2>/dev/null || true; sleep 1; fi
    start_daemon
    sleep 1
    start_session_agent
    restart_login_window_agent
  fi
  echo "installed ($mode start): $DAEMON_PLIST, $SESSION_PLIST, $LW_PLIST"
  echo "logs: $DAEMON_LOG, $LW_LOG"
  echo "keep RDMachine Server allowed under System Settings > General > Login Items & Extensions > Allow in the Background"
}

do_uninstall() {
  need_root uninstall
  uid=$(console_uid)
  [ "$uid" != 0 ] && launchctl bootout "gui/$uid/$SESSION_LABEL" 2>/dev/null || true
  launchctl bootout "system/$DAEMON_LABEL" 2>/dev/null || true
  pkill -TERM -f 'rdmachine-server --login-window' 2>/dev/null || true
  rm -f "$DAEMON_PLIST" "$SESSION_PLIST" "$LW_PLIST" "$AGENTS/org.rdmachine.loginwindow-experiment.plist"
  rm -rf "$SYS_DIR"
  echo "removed the daemon, the agents and $SYS_DIR (logs kept); start RDMachine Server.app to serve without them"
}

do_status() {
  echo "start mode:   $(startmode)"
  if [ -f "$DAEMON_PLIST" ]; then
    installed_app
    echo "server app:   $APP"
  fi
  procs=$(pgrep -fl 'Contents/MacOS/rdmachine-server' 2>/dev/null || true)
  if [ -z "$procs" ]; then
    echo "running:      nothing"
  else
    echo "$procs" | while read -r pid rest; do
      who=$(ps -o user= -p "$pid" 2>/dev/null | tr -d ' ')
      case "$rest" in
        *--daemon*) echo "running:      pid $pid, daemon ($who)" ;;
        *--login-window*) echo "running:      pid $pid, login window agent ($who)" ;;
        *) echo "running:      pid $pid, server of $who's session" ;;
      esac
    done
  fi
  if [ "$(id -u)" -eq 0 ]; then
    lsof -nP -iTCP -sTCP:LISTEN 2>/dev/null | awk '/rdmachine/ {print "listening:    " $9 " (pid " $2 ")"}' | sort -u
  fi
  echo "console:      $(console_user)"
  return 0
}

do_start() {
  need_root start
  [ -f "$DAEMON_PLIST" ] || { echo "not installed: sudo rdmachine-service install" >&2; exit 1; }
  installed_app
  start_daemon
  sleep 1
  start_session_agent
  echo "started"
}

do_stop() {  # "restart": the login window agent comes back by itself
  need_root stop
  # SIGTERM: a clean exit, so KeepAlive (SuccessfulExit = false) leaves it stopped.
  daemon_loaded && launchctl kill TERM "system/$DAEMON_LABEL" 2>/dev/null || true
  uid=$(console_uid)
  session_loaded && launchctl kill TERM "gui/$uid/$SESSION_LABEL" 2>/dev/null || true
  if [ "${1:-}" = restart ]; then
    restart_login_window_agent
    pgrep -f 'Contents/MacOS/rdmachine-server' 2>/dev/null | while read -r pid; do
      case "$(ps -o args= -p "$pid" 2>/dev/null)" in
        *--login-window*) ;;
        *) kill -TERM "$pid" 2>/dev/null || true ;;
      esac
    done
  else
    pkill -TERM -f 'Contents/MacOS/rdmachine-server' 2>/dev/null || true
  fi
  echo "stopped"
}

do_startmode() {
  need_root startmode
  [ -f "$DAEMON_PLIST" ] || { echo "not installed: sudo rdmachine-service install" >&2; exit 1; }
  installed_app
  case "${1:-}" in
    automatic) write_plists true ;;
    manual) write_plists false ;;
    *) usage 2 ;;
  esac
  echo "start mode: $1 (from the next startup or login)"
}

cmd="${1:-status}"
[ $# -gt 0 ] && shift
case "$cmd" in
  install)
    while [ $# -gt 0 ]; do
      case "$1" in
        --app) APP="$2"; shift 2 ;;
        *) usage 2 ;;
      esac
    done
    do_install ;;
  uninstall) do_uninstall ;;
  status) do_status ;;
  start) do_start ;;
  stop) do_stop ;;
  restart) do_stop restart; sleep 2; do_start ;;
  startmode) do_startmode "${1:-}" ;;
  -h|--help|help) usage 0 ;;
  *) usage 2 ;;
esac
