<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDisplayName</key>
	<string>RDMachine Server</string>
	<key>CFBundleExecutable</key>
	<string>rdmachine-server</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>@BUNDLE_ID@</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>RDMachine Server</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>@VERSION@</string>
	<key>CFBundleVersion</key>
	<string>@BUILD@</string>
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>@MIN_MACOS@</string>
	<!-- A menu bar app: an icon in the menu bar (status,
	     settings, the statistics panel), no Dock icon or main menu. It is an
	     app bundle so that macOS records the Screen Recording and
	     Accessibility permissions against this bundle and its signature
	     instead of against Terminal. -->
	<key>LSUIElement</key>
	<true/>
	<key>NSHumanReadableCopyright</key>
	<string>Apache License 2.0</string>
	<!-- What the System Audio Recording prompt says (the sound, docs/audio.md).
	     Without this key macOS refuses the permission without asking. -->
	<key>NSAudioCaptureUsageDescription</key>
	<string>RDMachine 把这台 Mac 的声音传给连接进来的客户端。</string>
</dict>
</plist>
